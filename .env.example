# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Sem essas variáveis o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).
#
# Painel do Supabase → Project Settings → API:
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# A chave pública do projeto: projetos novos mostram a "publishable key"
# (sb_publishable_...). Projetos antigos mostram a "anon" key (eyJ...).
# As duas são equivalentes: podem ser públicas, vão no cliente do site.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Nunca coloque a secret/service_role key aqui: ela ignora o RLS.
# Ela só é usada em scripts administrativos locais, fora do build do site.
